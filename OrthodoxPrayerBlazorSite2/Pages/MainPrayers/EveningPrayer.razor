
<Heading HeadingKind="HeadingKindEnum.MainHeading">
    Evening Prayer
</Heading>

<div class="options-container">
    <label for="sliderBriefnessLevel">Briefness Level: @BriefnessLevel</label>
    <input type="range" id="sliderBriefnessLevel" min="1" max="5" value="@BriefnessLevel" @oninput="OnBriefnessLevelChanged" />
</div>

<InTheNameOfTheTrinity />

@if (IsPaschaltide)
{
    <ChristIsRisen HeadingKind="HeadingKindEnum.None" />
}
else
{
    <OHeavenlyKingAndTrisagion HeadingKind="HeadingKindEnum.None" />
}

<OhMostHolyTrinity />

<LordHaveMercy TimesToSay="3" />

<GloryNowAndForever />

<OurFather HeadingKind="HeadingKindEnum.None" />

<LordHaveMercy TimesToSay="12" />

<ComeLetUsWorshipGodOurKing />

@if (IsBrief)
{
    <APrayerForForgiveness HeadingKind="HeadingKindEnum.SubHeading" />
}
else
{
    ImmutableList<RenderFragment> RandomizablePrayerItems = [
    @<APrayerForForgiveness HeadingKind="HeadingKindEnum.SubHeading" />,
    @<EveningIntercession HeadingKind="HeadingKindEnum.SubHeading" />,
    ];

    <RandomizablePrayer Items='RandomizablePrayerItems' />
}

<Psalm HeadingKind="HeadingKindEnum.SubHeading" PsalmTimeOfDayKind="PsalmTimeOfDayKindEnum.Evening" BriefnessLevel="BriefnessLevel" />

<GospelReading Date=Date HeadingKind="HeadingKindEnum.SubHeading" />

@if (HasNiceneCreed && !IsBrief)
{
    <NiceneCreed HeadingKind="HeadingKindEnum.SubHeading" />
}

@if (HasPrayerToMotherOfGod || !IsBrief)
{
    <TrulyMeetTheotokos HeadingKind="HeadingKindEnum.SubHeading" />
}

@if (IsLent)
{
    <LentStEphremPrayer HeadingKind="HeadingKindEnum.SubHeading" />
}

<ClosingPrayers HeadingKind="HeadingKindEnum.SubHeading" Date="Date" />

@code {
    [Parameter, EditorRequired]
    public DateTime Date { get; set; }

    [Parameter]
    public bool HasPrayerToMotherOfGod { get; set; } = false;

    [Parameter]
    public bool HasNiceneCreed { get; set; } = true;

    [Inject]
    public NilsEventService NilsEventService { get; set; } = null!;

    [Inject]
    public LocalStorageService LocalStorageService { get; set; } = null!;

    private const string BriefnessLevelStorageKey = "EveningPrayer_BriefnessLevel";

    private int BriefnessLevel { get; set; } = 3;

    private bool IsBrief => BriefnessLevel < 3;
    private bool IsPaschaltide => HolidayCalculator.IsPaschaltide(DateOnly.FromDateTime(Date));
    private bool IsLent => HolidayCalculator.IsGreatLent(DateOnly.FromDateTime(Date));


    protected override async Task OnInitializedAsync()
    {
        var savedBriefnessLevel = await LocalStorageService.GetIntAsync(BriefnessLevelStorageKey);
        if (savedBriefnessLevel is >= 1 and <= 5)
        {
            BriefnessLevel = savedBriefnessLevel.Value;
        }

        await base.OnInitializedAsync();
    }

    private async Task OnBriefnessLevelChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newBriefnessLevel))
        {
            BriefnessLevel = newBriefnessLevel;
            await LocalStorageService.SetIntAsync(BriefnessLevelStorageKey, BriefnessLevel);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        base.OnParametersSet();
    }


    public void Dispose() { }
}
