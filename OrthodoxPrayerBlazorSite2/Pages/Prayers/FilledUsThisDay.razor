@switch (LanguageKind)
{
    case LanguageKindEnum.EnglishOlder:
    {
        <PrayerLine>
            We thank Thee, O Christ our God, for Thou hast satisfied us with Thy terrestrial gifts;
        </PrayerLine>
        <PrayerLine>
            deprive us not of Thy Heavenly Kingdom,
        </PrayerLine>
        <PrayerLine>
            but as Thou camest into the midst of Thy disciples, O Saviour, and gavest them peace, come also unto us and save us.
        </PrayerLine>
        <PrayerLine>
            Amen.
        </PrayerLine>
        break;
    }
    case LanguageKindEnum.EnglishModern:
    case LanguageKindEnum.EnglishMixed:
    default:
    {
        <PrayerLine>
            We thank you, O Christ our God, for You have filled us this day with Your earthly gifts.
        </PrayerLine>
        <PrayerLine>
            Deprive us not of Your heavenly kingdom,
        </PrayerLine>
        <PrayerLine>
            but as You came among Your disciples and gave them peace, come among us also, O Savior, and save us.
        </PrayerLine>
        <PrayerLine>
            Amen.
        </PrayerLine>
        break;
    }
}


@code {
    [CascadingParameter]
    public LanguageKindEnum LanguageKind { get; set; } = LanguageKindEnum.EnglishModern;
}
